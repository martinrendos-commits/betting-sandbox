# Skopíruj tento súbor ako `.env` (je v .gitignore) a doplň svoj kľúč.
# Premenná nastavená priamo v termináli má vždy prednosť pred týmto súborom.

FOOTBALLDATA_API_KEY=fd_sem_vloz_svoj_kluc

